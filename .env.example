# Copia este ficheiro para .env.local e preenche com a configuração do teu projecto Firebase
# (Consola Firebase → Definições do projecto → As tuas apps → Web → SDK setup and configuration).
# Sem estes valores o quadro funciona na mesma, só não tem o botão "Partilhar" activo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
